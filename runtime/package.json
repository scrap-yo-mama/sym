{
  "name": "runtime",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:fast": "vitest run --project unit --project contract",
    "test:integration": "node scripts/test-integration.ts",
    "test:e2e": "pnpm --filter @runtime/extension test:e2e && pnpm --filter @runtime/web test:e2e && playwright test -c tests/e2e/playwright.config.ts",
    "test:security": "vitest run --project security",
    "test:image": "vitest run --project image",
    "eval": "node eval/scripts/eval.ts",
    "fixtures": "node fixtures/src/main.ts",
    "zz:cleanup": "node scripts/not-implemented.ts zz:cleanup 'tâche 0.5'",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.typecheck.json && pnpm --filter @runtime/web typecheck && pnpm --filter @runtime/extension typecheck && pnpm --filter @runtime/docs typecheck && pnpm --filter @runtime/ui typecheck",
    "knip": "knip",
    "deps:report": "depcruise --config .dependency-cruiser.cjs apps packages",
    "check:invariants": "node scripts/check-invariants.ts",
    "check:x6": "node scripts/check-x6.ts",
    "check:x6-history": "node scripts/check-x6.ts --history",
    "test:coverage": "vitest run --project unit --coverage",
    "check:deps-pinned": "node scripts/check-deps-pinned.ts",
    "check:licenses": "node scripts/check-licenses.ts",
    "spdx:add": "node scripts/spdx-headers.ts",
    "check:blacklist": "node scripts/check-blacklist.ts",
    "i18n:check": "pnpm --filter @runtime/i18n i18n:parity && pnpm --filter @runtime/i18n i18n:types --check && pnpm --filter @runtime/i18n i18n:pseudo",
    "hooks:install": "git config core.hooksPath runtime/scripts/hooks",
    "ci:local": "node scripts/ci-local.ts",
    "visual:image": "node scripts/visual-image.ts",
    "gen:openapi": "node scripts/gen-openapi-client.ts",
    "check:openapi-client": "node scripts/gen-openapi-client.ts --check",
    "package:extension": "node scripts/extension-package.ts",
    "vitrine:check": "node scripts/vitrine/check.mjs",
    "vitrine:claims": "node scripts/vitrine/claims-md.mjs",
    "vitrine:community": "node scripts/vitrine/community-md.mjs",
    "assets:render": "node scripts/vitrine/render-assets.mjs",
    "brand:sync": "node scripts/vitrine/brand-sync.mjs",
    "release:dry-run": "node scripts/release/dry-run.ts",
    "check:release": "node scripts/release/gates.ts",
    "docs:build": "pnpm --filter @runtime/docs build",
    "docs:test": "vitest run --project unit --project contract apps/docs",
    "docs:quickstart": "node scripts/docs-quickstart.ts",
    "gen:env-docs": "node scripts/gen-env-docs.ts",
    "check:env-docs": "node scripts/gen-env-docs.ts --check",
    "landing:test": "vitest run --project unit --project contract apps/docs/src/landing && pnpm --filter @runtime/docs test:e2e",
    "check:landing-go": "pnpm --filter @runtime/docs landing:go",
    "landing:probe": "pnpm --filter @runtime/docs landing:probe"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@intlify/eslint-plugin-vue-i18n": "catalog:",
    "@modelcontextprotocol/conformance": "catalog:",
    "@playwright/test": "catalog:",
    "@redocly/openapi-core": "catalog:",
    "@runtime/agent": "workspace:*",
    "@runtime/core": "workspace:*",
    "@runtime/db": "workspace:*",
    "@runtime/i18n": "workspace:*",
    "@runtime/llm": "workspace:*",
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/ws": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "ajv": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "fastify": "catalog:",
    "knip": "catalog:",
    "openapi-typescript": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "playwright-core": "catalog:",
    "standardwebhooks": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-eslint-parser": "catalog:",
    "ws": "catalog:",
    "yaml": "catalog:"
  }
}
