{
  "name": "@sym-browser/module",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Racine du module SYM Browser : CI locale du module, tests de frontière et d'environnement. Les paquets sont dans apps/ et packages/.",
  "scripts": {
    "ci:local": "node scripts/ci-local.ts",
    "fixtures": "node fixtures/src/up.ts up",
    "fixtures:down": "node fixtures/src/up.ts down",
    "fixtures:local": "node fixtures/src/main.ts local",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:chromium": "vitest run --config vitest.chromium.config.ts",
    "test:quickstart": "vitest run --config vitest.quickstart.config.ts",
    "docs:reference": "node scripts/docs-reference.ts",
    "test:deploy": "vitest run tests/deploy.e2e.test.ts"
  },
  "devDependencies": {
    "@browserbasehq/stagehand": "catalog:",
    "@sym/contracts": "workspace:*",
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/ws": "catalog:",
    "eslint": "catalog:",
    "fastify": "catalog:",
    "pg": "catalog:",
    "playwright-core": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "ws": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  }
}
