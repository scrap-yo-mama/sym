{
  "name": "@sym-browser/node",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "SYM Browser : nœud (pool de Chromium chauds, sessions, egress par session).",
  "exports": {
    "./sessions": {
      "types": "./dist/sessions/index.d.ts",
      "default": "./dist/sessions/index.js"
    },
    "./usage": {
      "types": "./dist/usage/index.d.ts",
      "default": "./dist/usage/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:chromium": "vitest run --config vitest.chromium.config.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@sym-browser/core": "workspace:*",
    "@sym/contracts": "workspace:*",
    "playwright-core": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
