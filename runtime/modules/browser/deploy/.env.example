# SPDX-License-Identifier: AGPL-3.0-only
# Secrets de SYM Browser pour Docker Compose : copie ce fichier en .env (jamais versionné) et remplis chaque valeur.
# Aucune valeur n'est fournie ici. Commandes, depuis runtime/ d'un clone (ou avec l'image : voir README.md) :
#   MASTER_KEY             pnpm --filter @sym-browser/core keygen      (32 octets base64 ; à sauvegarder hors de la machine)
#   SYMB_BOOTSTRAP_API_KEY pnpm --filter @sym-browser/core apikey      (première clé d'API, client « sym »)
#   NODE_TOKEN             openssl rand -base64 32                     (passerelle + nœuds seulement)
#   POSTGRES_PASSWORD      openssl rand -hex 24                        (caractères sûrs dans une URL)
MASTER_KEY=
SYMB_BOOTSTRAP_API_KEY=
NODE_TOKEN=
POSTGRES_PASSWORD=
# Image (défaut ghcr.io/scrap-yo-mama/sym-browser:1) et adresse publiée (défaut 127.0.0.1:3000).
# SYMB_IMAGE=
# SYMB_BIND=
