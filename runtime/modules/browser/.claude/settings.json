{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Bash(git add .:*)",
      "Bash(git add -u:*)",
      "Bash(git commit -a:*)",
      "Bash(git commit --all:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --mirror:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(git filter-repo:*)",
      "Bash(kill -1:*)",
      "Bash(kill -9 -1:*)",
      "Bash(kill -KILL -1:*)",
      "Bash(killall:*)",
      "Read(./scraper.py)",
      "Read(./google_scraper.py)",
      "Read(./anticaptcha.py)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/master.key)",
      "Read(**/scraper.py)",
      "Read(**/google_scraper.py)",
      "Read(**/anticaptcha.py)",
      "Read(**/dist/**)",
      "Write(**/*.py)",
      "Write(**/*.ipynb)",
      "Edit(**/*.py)",
      "Edit(**/*.ipynb)",
      "Write(**/.env)",
      "Edit(**/.env)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(docker push:*)",
      "Bash(gh release:*)",
      "Bash(gh repo create:*)",
      "Bash(cosign sign:*)"
    ]
  },
  "autoMemoryDirectory": "~/.claude-memory/scrapyomama-browser"
}
