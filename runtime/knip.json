{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "exclude": [
    "catalog"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "tests/**/*.test.ts",
        "eval/scripts/*.ts",
        "eval/**/*.test.ts"
      ],
      "project": [
        "scripts/**/*.ts",
        "tests/**/*.ts",
        "eval/**/*.ts"
      ]
    },
    "packages/*": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "apps/*": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "apps/server": {
      "entry": [
        "src/index.ts"
      ]
    },
    "apps/worker": {
      "entry": [
        "src/index.ts",
        "src/testing/*.testkit.ts"
      ]
    },
    "fixtures": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "apps/web": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,vue}"
      ],
      "ignoreDependencies": [
        "tailwindcss",
        "tw-animate-css",
        "@runtime/core",
        "@runtime/db",
        "@runtime/schemas"
      ],
      "ignoreIssues": {
        "src/components/ui/**": [
          "exports",
          "types",
          "files"
        ]
      }
    },
    "packages/client": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ],
      "ignoreIssues": {
        "src/generated/**": [
          "exports",
          "types"
        ]
      }
    },
    "apps/extension": {
      "entry": [
        "src/entrypoints/**/*.{ts,html}",
        "src/**/*.test.ts",
        "e2e/*.e2e.ts"
      ],
      "project": [
        "src/**/*.ts",
        "e2e/**/*.ts",
        "*.ts"
      ]
    }
  }
}
