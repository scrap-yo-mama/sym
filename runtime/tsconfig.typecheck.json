{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "fixtures/src/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "eval/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "apps/web/**",
    "apps/extension/**"
  ]
}
