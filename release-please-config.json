{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "separate-pull-requests": false,
  "changelog-path": "CHANGELOG.md",
  "packages": {
    "runtime": {
      "package-name": "scrapyomama-runtime",
      "extra-files": [
        {
          "type": "json",
          "path": "apps/cli/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/docs/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/extension/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/server/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/web/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/worker/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "fixtures/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/agent/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/client/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/core/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/db/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/llm/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/schemas/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/ui/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "generic",
          "path": "deploy/docker-compose.prod.yml"
        },
        {
          "type": "generic",
          "path": "deploy/heroku/Dockerfile.web"
        },
        {
          "type": "generic",
          "path": "deploy/heroku/Dockerfile.worker"
        },
        {
          "type": "generic",
          "path": "deploy/railway/template.yaml"
        },
        {
          "type": "generic",
          "path": "/render.yaml"
        }
      ]
    }
  }
}
